{
  "manifest_version": 1,
  "type": "device",
  "name": "WiZ",
  "description": {
    "en": "WiZ bulbs, light strips and plugs on the local network: colors, whites, WiZ scenes.",
    "fr": "Ampoules, rubans et prises WiZ en réseau local : couleurs, blancs, scènes WiZ.",
    "de": "WiZ-Lampen, LED-Streifen und Steckdosen im lokalen Netzwerk: Farben, Weißtöne, WiZ-Szenen.",
    "es": "Bombillas, tiras LED y enchufes WiZ en la red local: colores, blancos, escenas WiZ."
  },
  "version": "1.0.2",
  "docker_image": "ghcr.io/guim31/gladys-wiz:1.0.2",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-wiz/main/cover.png",
  "categories": ["lighting"],
  "transports": ["local"],
  "network_discovery": [
    {
      "type": "udp-active-broadcast",
      "ports": [38899]
    }
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Finding your WiZ devices",
        "fr": "Trouver vos appareils WiZ",
        "de": "Deine WiZ-Geräte finden",
        "es": "Encontrar sus dispositivos WiZ"
      },
      "description": {
        "en": "WiZ lights and plugs on the same network as Gladys are found automatically: open the Discovery tab. Keep them set up in the WiZ app, with \"Allow local communication\" turned on. If one is missing, enter its IP address below.",
        "fr": "Les lampes et prises WiZ du même réseau que Gladys sont trouvées automatiquement : ouvrez l'onglet Découverte. Gardez-les configurées dans l'application WiZ, avec « Autoriser la communication locale » activé. S'il en manque une, saisissez son adresse IP ci-dessous.",
        "de": "WiZ-Lampen und -Steckdosen im selben Netzwerk wie Gladys werden automatisch gefunden: Öffne den Tab „Entdecken“. Lass sie in der WiZ-App eingerichtet, mit aktivierter „Lokale Kommunikation zulassen“. Fehlt eine, gib unten ihre IP-Adresse ein.",
        "es": "Las luces y enchufes WiZ de la misma red que Gladys se encuentran automáticamente: abra la pestaña Descubrir. Manténgalos configurados en la aplicación WiZ, con «Permitir la comunicación local» activado. Si falta alguno, introduzca su dirección IP a continuación."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-wiz/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Installationsanleitung",
            "es": "Guía de instalación"
          }
        }
      ]
    },
    {
      "key": "hosts",
      "type": "string",
      "label": {
        "en": "IP addresses of WiZ devices",
        "fr": "Adresses IP des appareils WiZ",
        "de": "IP-Adressen der WiZ-Geräte",
        "es": "Direcciones IP de los dispositivos WiZ"
      },
      "description": {
        "en": "Optional, separated by commas. Only needed for the devices automatic discovery does not find.",
        "fr": "Facultatif, séparées par des virgules. Seulement pour les appareils que la découverte automatique ne trouve pas.",
        "de": "Optional, durch Kommas getrennt. Nur für Geräte nötig, die die automatische Erkennung nicht findet.",
        "es": "Opcional, separadas por comas. Solo para los dispositivos que el descubrimiento automático no encuentra."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.50, 192.168.1.51",
        "fr": "ex. 192.168.1.50, 192.168.1.51",
        "de": "z. B. 192.168.1.50, 192.168.1.51",
        "es": "p. ej. 192.168.1.50, 192.168.1.51"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle d'actualisation",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often each device is read, to follow the changes made from the WiZ app, a remote or a wall switch.",
        "fr": "Fréquence de lecture de chaque appareil, pour suivre les changements faits depuis l'application WiZ, une télécommande ou un interrupteur mural.",
        "de": "Wie oft jedes Gerät gelesen wird, um Änderungen aus der WiZ-App, über eine Fernbedienung oder einen Wandschalter zu verfolgen.",
        "es": "Frecuencia de lectura de cada dispositivo, para seguir los cambios hechos desde la aplicación WiZ, un mando o un interruptor de pared."
      },
      "required": false,
      "default": "15",
      "options": [
        {
          "value": "5",
          "label": {
            "en": "5 seconds",
            "fr": "5 secondes",
            "de": "5 Sekunden",
            "es": "5 segundos"
          }
        },
        {
          "value": "10",
          "label": {
            "en": "10 seconds",
            "fr": "10 secondes",
            "de": "10 Sekunden",
            "es": "10 segundos"
          }
        },
        {
          "value": "15",
          "label": {
            "en": "15 seconds",
            "fr": "15 secondes",
            "de": "15 Sekunden",
            "es": "15 segundos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 seconds",
            "fr": "30 secondes",
            "de": "30 Sekunden",
            "es": "30 segundos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "60 seconds",
            "fr": "60 secondes",
            "de": "60 Sekunden",
            "es": "60 segundos"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the device names",
        "fr": "Langue des noms des appareils",
        "de": "Sprache der Gerätenamen",
        "es": "Idioma de los nombres de los dispositivos"
      },
      "description": {
        "en": "Names given to new devices, their features and the WiZ scene list (Light, Brightness, Ocean...).",
        "fr": "Noms donnés aux nouveaux appareils, à leurs fonctionnalités et à la liste des scènes WiZ (Éclairage, Luminosité, Océan…).",
        "de": "Namen, die neuen Geräten, ihren Funktionen und der WiZ-Szenenliste gegeben werden (Licht, Helligkeit, Ozean…).",
        "es": "Nombres dados a los nuevos dispositivos, a sus funciones y a la lista de escenas WiZ (Luz, Brillo, Océano…)."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
