  "actions": [
    {
      "key": "search",
      "label": {
        "en": "Search for WiZ devices",
        "fr": "Rechercher les appareils WiZ",
        "de": "WiZ-Geräte suchen",
        "es": "Buscar dispositivos WiZ"
      },
      "description": {
        "en": "Looks for WiZ devices again and reports the ones found.",
        "fr": "Recherche à nouveau les appareils WiZ et liste ceux trouvés.",
        "de": "Sucht erneut nach WiZ-Geräten und listet die gefundenen auf.",
        "es": "Busca de nuevo los dispositivos WiZ e indica los encontrados."
      },
      "timeout_seconds": 60
    }
  ],
  "scene_triggers": [
    {
      "key": "switched_outside_gladys",
      "label": {
        "en": "WiZ device switched outside Gladys",
        "fr": "Appareil WiZ allumé ou éteint hors de Gladys",
        "de": "WiZ-Gerät außerhalb von Gladys geschaltet",
        "es": "Dispositivo WiZ encendido o apagado fuera de Gladys"
      },
      "description": {
        "en": "A WiZ light or plug was turned on or off without Gladys: from the WiZ app, a remote, a WiZ schedule, or by its power (wall switch, power cut).",
        "fr": "Une lampe ou une prise WiZ a été allumée ou éteinte sans Gladys : depuis l'application WiZ, une télécommande, un programme WiZ, ou par son alimentation (interrupteur mural, coupure de courant).",
        "de": "Eine WiZ-Lampe oder -Steckdose wurde ohne Gladys ein- oder ausgeschaltet: über die WiZ-App, eine Fernbedienung, einen WiZ-Zeitplan oder über ihre Stromversorgung (Wandschalter, Stromausfall).",
        "es": "Una luz o un enchufe WiZ se encendió o apagó sin Gladys: desde la aplicación WiZ, un mando, una programación WiZ o por su alimentación (interruptor de pared, corte de corriente)."
      },
